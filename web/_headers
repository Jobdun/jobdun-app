# Headers for the Jobdun WEB APP (app.jobdun.com.au), built from lib/main.dart.
#
# This file used to carry the marketing site's rules — including a
# `Permissions-Policy` that switched OFF camera and geolocation, which are two
# features the consumer app actually needs (document/portfolio capture, "jobs
# near me"). Corrected in the 2026-08-19 platform audit.
#
# FORMAT NOTE: `_headers` is the Cloudflare Pages / Netlify convention. The app
# is deployed on **Vercel** (project `jobdun-app`), which ignores this file —
# `vercel.json` next to it is the one that actually takes effect there. Both are
# kept in sync so a host change doesn't silently drop every header. Keep this
# note here rather than in `vercel.json`: JSON has no comments, and Vercel
# rejects a deploy outright if vercel.json carries an unknown key.
#
# Both files live in `web/` so `flutter build web` copies them into `build/web/`
# — the directory that is actually deployed. If the Vercel project is ever
# switched to build from the repo root instead of deploying `build/web` as a
# static directory, `vercel.json` has to move to the repo root to take effect.
#
# No SPA rewrite rule is needed: nothing in `lib/` calls `usePathUrlStrategy`,
# so GoRouter runs on Flutter web's default HASH strategy — deep links look
# like `/#/jobs/123` and the server only ever sees `/`.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # camera  -> verification docs, portfolio shots, avatars
  # geolocation -> "use my current location" + the nearby-jobs map
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=(), usb=()
  # The app is a signed-in product surface. jobdun.com.au is the indexed
  # marketing entry point; this host must not compete with it in search
  # results. (The inverse rule applied when this file served the marketing
  # site — do not "restore" that comment here.)
  X-Robots-Tag: noindex, nofollow

# CACHING. Flutter web asset URLs are NOT content-hashed — /assets/…,
# /canvaskit/… and main.dart.js keep the same path across releases — and the
# Flutter service worker shipped in 3.41 is a self-unregistering stub, so it
# provides no cache versioning either. The previous `immutable, max-age=1y`
# rule therefore pinned returning users to a year-old bundle. Short TTL +
# revalidation keeps repeat loads cheap (304s) without stranding anyone on a
# stale release.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

/canvaskit/*
  Cache-Control: public, max-age=3600, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

# The bundled client config (Supabase URL + anon key, Google client ids,
# MapTiler key, Sentry DSN). Public by design — it ships inside every APK/IPA
# too — but on web it is a fetchable URL, so never let a rotated key sit in a
# browser cache.
/assets/.env
  Cache-Control: no-store

# Entry document + loader must always be fresh, or a release ships to nobody.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
